<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gryphon_arm">

    <!-- Ignition Gazebo: gz_ros2_control plugin -->
    <gazebo>
        <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find gryphon_controller)/config/gryphon_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ===== Gripper Finger Friction & Contact Properties ===== -->

    <!-- Right Finger -->
    <gazebo reference="gripper_finger_right">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.002</minDepth>
        <maxVel>0.0</maxVel>
        <selfCollide>false</selfCollide>
    </gazebo>

    <!-- Left Finger -->
    <gazebo reference="gripper_finger_left">
        <mu1>100.0</mu1>
        <mu2>100.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.002</minDepth>
        <maxVel>0.0</maxVel>
        <selfCollide>false</selfCollide>
    </gazebo>

    <!-- Gripper base (link_5) also benefits from contact tuning -->
    <gazebo reference="link_5">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

</robot>